tive="1" as="geometry"/></mxCell><mxCell id="e14_r2_d0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="d0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15_g2_d4" value="fail → về huấn luyện" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ba" value="&lt;b&gt;BA / QC ở mỗi bước&lt;/b&gt;&lt;br&gt;• Kịch bản &amp; ODD: precondition · success · failure · abort · human takeover&lt;br&gt;• Annotation guide: nhãn perception ≠ nhãn hành động ≠ nhãn thành công nhiệm vụ&lt;br&gt;• Coverage matrix: site/zone · sáng–tối · mật độ người · pin · mạng · version&lt;br&gt;• Golden scenarios khóa version; không sửa benchmark để candidate pass&lt;br&gt;• Gate evidence → RTM: requirement → story → test → kết quả → release" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;strokeColor=#D97706;fillColor=#FFFBEB;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1288" y="470" width="280" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>