<mxfile host="Electron" agent="Claude" version="24.0.0"><diagram id="p1" name="1. Data flywheel &amp; gate"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="17 · Dữ liệu robot → huấn luyện → các cổng đánh giá → phát hành OTA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1520" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Không auto-retrain rồi tự rollout. Mỗi cổng có bằng chứng và người duyệt; simulation không thay thử nghiệm phần cứng." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1520" height="22" as="geometry"/></mxCell><mxCell id="d0" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Vận hành thực địa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;log · cảnh báo sai · can thiệp của người · lỗi mission&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="84" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Thu thập&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;rosbag2 / MCAP · teleop demo · đồng bộ timestamp&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="352" y="110" width="280" height="84" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Data Factory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;curation · gắn tag kịch bản · gán nhãn CVAT / Label Studio&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="664" y="110" width="280" height="84" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Dataset registry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;version · split theo site/ca/episode · manifest&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="976" y="110" width="280" height="84" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Huấn luyện&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;YOLO / VLM LoRA · VLA (GR00T) fine-tune · RL (Isaac Lab)&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#D97706;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1288" y="110" width="280" height="84" as="geometry"/></mxCell><mxCell id="g0" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Gate 1 · Offline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;metric theo slice · hard negatives · model đã lượng tử hóa&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1288" y="280" width="280" height="84" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Gate 2 · SIL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;Isaac Sim / Gazebo · người, vật cản, mất mạng&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="976" y="280" width="280" height="84" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Gate 3 · HIL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;phần cứng thật · khu thử có kiểm soát&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="664" y="280" width="280" height="84" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Gate 4 · Test site&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;tuyến thật ngoài giờ · có người giám sát&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="352" y="280" width="280" height="84" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Gate 5 · Pilot shadow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;chạy song song, không tác động điều khiển&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="280" height="84" as="geometry"/></mxCell><mxCell id="r0" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Release manifest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;firmware · model · skill · map · policy pack · eval run&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E11D48;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="280" height="84" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b style=&quot;font-size:12px;&quot;&gt;OTA canary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;1 robot → 1 zone → toàn site · ngoài giờ cao điểm&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E11D48;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="352" y="450" width="280" height="84" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Fleet production&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;theo dõi drift · field failure · KPI&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E11D48;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="664" y="450" width="280" height="84" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Rollback bundle&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;khi vượt ngưỡng: trả cả bộ tương thích; không hoàn tác được hành động vật lý&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#DC2626;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="976" y="450" width="280" height="84" as="geometry"/></mxCell><mxCell id="e1_d0_d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2_d1_d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="d2"><mx