;lương 18tr vs ngạch 24tr → 25%&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zB"><mxGeometry x="770" y="40" width="357" height="80" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Feature PASS → chạy end-to-end&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zB"><mxGeometry x="1147" y="40" width="357" height="80" as="geometry"/></mxCell><mxCell id="e6_b1_b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7_b2_b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8_b3_b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tri" value="&lt;b&gt;Phân loại lỗi → đội xử lý&lt;/b&gt;&lt;br&gt;Data (sai KPI, thiếu lịch sử) → Data/ETL · Mapping (nhầm nhân viên) → Backend · Business rule → BA/HR · Prompt (quá chắc chắn) → AI · Model (không hiểu nhận xét tiếng Việt) → Data Science · Hallucination → AI · Recommendation (đề xuất không phù hợp) → BA/HR/AI · UI · Performance" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#E11D48;fillColor=#FFF1F2;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1000" height="110" as="geometry"/></mxCell><mxCell id="size" value="&lt;b&gt;Quy mô test run&lt;/b&gt;&lt;br&gt;smoke 10–20 · functional 100–300 · golden regression 200 · edge case 50–100 · data quality 50&lt;br&gt;Ma trận 6×5×4×4×4 = 1.920 tổ hợp → pairwise còn vài chục ca" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#94A3B8;fillColor=#F8FAFC;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1060" y="460" width="500" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>