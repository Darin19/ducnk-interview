=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q3" target="q4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4_q4_q5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q4" target="q5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5_q5_q6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q5" target="q6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6_q6_q7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q6" target="q7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7_q7_q8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q7" target="q8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="exq" value="&lt;b&gt;Ngoại lệ đã đặc tả&lt;/b&gt;&lt;br&gt;• state_version đổi giữa chừng → STATE_CONFLICT, tải lại context, không áp hướng dẫn cũ&lt;br&gt;• Cán bộ không có thẩm quyền với mức phạt → nêu cấp có thẩm quyền, không hiện nút thao tác&lt;br&gt;• Không tìm được căn cứ → nói rõ, đề nghị hỏi pháp chế; không suy diễn&lt;br&gt;• Workflow timeout → trả lời phần đã có, đánh dấu &quot;chưa xác minh trạng thái&quot;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="1000" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>