<mxfile host="Electron" agent="Claude" version="24.0.0"><diagram id="p1" name="1. Mission"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="16 · State machine của Mission (nhiệm vụ robot)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1520" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="&quot;Đã gửi lệnh&quot; ≠ &quot;robot đã chạy&quot; ≠ &quot;đã hoàn thành&quot;. Timeout là trạng thái chưa xác định, không phải thất bại." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1520" height="22" as="geometry"/></mxCell><mxCell id="m0" value="&lt;b style=&quot;font-size:12px;&quot;&gt;DRAFT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;operator / workflow tạo&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#F9FAFB;strokeColor=#6B7280;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="196" height="64" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b style=&quot;font-size:12px;&quot;&gt;VALIDATING&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;quyền · ODD · map · policy&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#EFF6FF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="258" y="250" width="196" height="64" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b style=&quot;font-size:12px;&quot;&gt;QUEUED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;chờ robot đủ điều kiện&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#EFF6FF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="476" y="250" width="196" height="64" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b style=&quot;font-size:12px;&quot;&gt;ASSIGNED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;lease · command_id · TTL · epoch&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#F5F3FF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="694" y="250" width="196" height="64" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b style=&quot;font-size:12px;&quot;&gt;ACKNOWLEDGED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;robot nhận, recheck health · pin&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#F5F3FF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="912" y="250" width="196" height="64" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b style=&quot;font-size:12px;&quot;&gt;EXECUTING&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;ROS action feedback&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#F5F3FF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1130" y="250" width="196" height="64" as="geometry"/></mxCell><mxCell id="m6" value="&lt;b style=&quot;font-size:12px;&quot;&gt;SUCCEEDED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;result + evidence hợp lệ&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#ECFDF5;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1348" y="250" width="196" height="64" as="geometry"/></mxCell><mxCell id