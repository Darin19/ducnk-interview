ogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m4" target="x6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14_x6_m3" value="giao robot khác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="x6" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15_m5_x4" value="mất kết nối" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m5" target="x4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16_x4_m5" value="kết nối lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="x4" target="m5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17_x4_x5" value="lease hết + fencing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="x