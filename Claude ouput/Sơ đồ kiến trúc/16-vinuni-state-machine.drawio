 Trạng thái robot, kết nối và incident là ba trục riêng" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1520" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Online chưa chắc sẵn sàng; sẵn sàng còn phụ thuộc health, mode, policy và pin." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1520" height="22" as="geometry"/></mxCell><mxCell id="za" value="Trạng thái vận hành robot" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#2563EB;container=1;collapsible=0;recursiveResize=0;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1000" height="330" as="geometry"/></mxCell><mxCell id="rd" value="&lt;b style=&quot;font-size:12px;&quot;&gt;READY&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;đủ capability&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#ECFDF5;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="za"><mxGeometry x="30" y="50" width="190" height="62" as="geometry"/></mxCell><mxCell id="bz" value="&lt;b style=&quot;font-size:12px;&quot;&gt;BUSY&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;đang có mission&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#F5F3FF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="za"><mxGeometry x="290" y="50" width="190" height="62" as="geometry"/></mxCell><mxCell id="dg" value="&lt;b style=&quot;font-size:12px;&quot;&gt;DEGRADED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;sensor lỗi 