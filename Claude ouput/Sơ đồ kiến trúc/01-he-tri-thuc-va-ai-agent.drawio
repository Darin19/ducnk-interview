yle=&quot;font-size:10px;color:#475569;&quot;&gt;bge-m3 → Qdrant · BM25 → OpenSearch&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1198" y="110" width="169" height="78" as="geometry"/></mxCell><mxCell id="i8" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Publish snapshot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;alias kb_vN · golden retrieval pass&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1391" y="110" width="169" height="78" as="geometry"/></mxCell><mxCell id="e1_i1_i2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2_i2_i3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i2" target="i3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3_i3_i4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i3" target="i4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4_i4_i5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i4" target="i5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5_i5_i6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i5" target="i6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6_i6_i7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i6" target="i7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7_i7_i8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i7" target="i8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Từ chối&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;file hỏng · thiếu trang · không rõ nguồn&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#DC2626;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="260" width="170" height="64" as="geometry"/></mxCell><mxCell id="x2" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Cần sửa OCR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;đối chiếu ảnh gốc · sửa tay vùng lỗi&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#EA580C;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="260" width="170" height="64" as="geometry"/></mxCell><mxCell id="x3" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Hết hiệu lực / bị thay thế&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;văn bản mới ban hành&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#EA580C;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="980" y="260" width="190" height="64" as="geometry"/></mxCell><mxCell id="x4" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Tombstone + reindex&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;xóa khỏi index · xóa cache · ghi lịch sử&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#EA580C;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1200" y="260" width="190" height="64" as="geometry"/></mxCell><mxCell id="e8_i2_x1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i2" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9_i3_x2" value="CER cao" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i3" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10_x2_i3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="x2" target="i3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11_x3_x4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="x3" target="x4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12_x4_i8" value="snapshot mới" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="x4" target="i8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="meta" value="&lt;b&gt;Metadata bắt buộc cho mỗi chunk&lt;/b&gt;&lt;br&gt;document_id · version · source_url · checksum · owner&lt;br&gt;effective_from / effective_to · jurisdiction (cấp áp dụng) · authority (cơ quan)&lt;br&gt;audience (công khai / cán bộ / nội bộ) · classification · ACL role/đơn vị&lt;br&gt;heading_path (Chương › Điều › Khoản) · page · bbox · parent_chunk_id · language" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#F8FAFC;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="700" height="140" as="geometry"/></mxCell><mxCell id="qa" value="&lt;b&gt;QC trước khi publish&lt;/b&gt;&lt;br&gt;• Lấy mẫu chunk: đủ điều/khoản, không mất phủ định, đơn vị, ngoại lệ&lt;br&gt;• Golden retrieval: Recall@5, MRR trên bộ câu hỏi có nguồn gold&lt;br&gt;• Câu hỏi không có đáp án → phải trả NO_EVIDENCE&lt;br&gt;• Kiểm thử rò quyền: user công khai không thấy chunk nội bộ&lt;br&gt;• So sánh với snapshot trước: không regression nhóm câu hỏi cũ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#FDA4AF;fillColor=#FFF1F2;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="760" y="370" width="800" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>