<mxfile host="Electron" agent="Claude" version="24.0.0"><diagram id="p1" name="1. BA-QC trong vòng đời AI"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1860" pageHeight="1200" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="02 · Vòng đời dữ liệu → training/fine-tune → đánh giá → phát hành, và việc của BA + QC" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1780" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Áp dụng cho HRAI, mChat, OCR/VLM, Smart Safe camera, Smart Factory ML. Vòng lặp chỉ nhận feedback đã được duyệt thành gold label." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1780" height="22" as="geometry"/></mxCell><mxCell id="lBA" value="BA / Product" style="swimlane;horizontal=0;startSize=150;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;fontSize=13;fontColor=#2563EB;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1780" height="120" as="geometry"/></mxCell><mxCell id="lQC" value="QC / Data" style="swimlane;horizontal=0;startSize=150;html=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;fontStyle=1;fontSize=13;fontColor=#059669;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="1780" height="120" as="geometry"/></mxCell><mxCell id="lAI" value="AI Engineer" style="swimlane;horizontal=0;startSize=150;html=1;whiteSpace=wrap;fillColor=#FFFBEB;strokeColor=#D97706;fontStyle=1;fontSize=13;fontColor=#D97706;swimlaneFillColor=#FFFFFF;collapsibl