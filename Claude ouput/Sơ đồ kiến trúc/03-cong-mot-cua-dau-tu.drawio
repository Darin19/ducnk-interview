" vertex="1" parent="1"><mxGeometry x="330" y="160" width="200" height="60" as="geometry"/></mxCell><mxCell id="bm" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Biểu mẫu&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;mẫu số · phiên bản&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#EEF2FF;strokeColor=#4F46E5;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="200" height="60" as="geometry"/></mxCell><mxCell id="cq" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Cơ quan thẩm quyền&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;Sở TC · BQL KCN · UBND&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#EEF2FF;strokeColor=#4F46E5;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="690" y="140" width="200" height="60" as="geometry"/></mxCell><mxCell id="th" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Thời hạn giải quyết&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;ngày làm việc&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#EEF2FF;strokeColor=#4F46E5;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="200" height="60" as="geometry"/></mxCell><mxCell id="dk" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Điều / khoản VBPL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;trích dẫn nguyên văn&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#FFFBEB;strokeColor=#D97706;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="200" height="60" as="geometry"/></mxCell><mxCell id="vb" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Văn bản pháp luật&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;hiệu lực từ / đến&lt;/span&gt;" style="rounded=1;arcSize=40;fillCo