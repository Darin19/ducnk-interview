<mxfile host="Electron" agent="Claude" version="24.0.0"><diagram id="p1" name="1. Kiến trúc"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="03 · Cổng một cửa đầu tư quốc gia — Hệ tri thức &amp;amp; Trợ lý AI + Trục tích hợp &amp;amp; Quản trị dữ liệu" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1520" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Ba module phụ trách trong 17 module: Trục tích hợp &amp;amp; quản trị dữ liệu · Hệ tri thức &amp;amp; Trợ lý AI · Quản lý đầu tư nước ngoài." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1520" height="22" as="geometry"/></mxCell><mxCell id="zU" value="Người dùng" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#2563EB;container=1;collapsible=0;recursiveResize=0;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="92" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Nhà đầu tư trong nước&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;tra cứu thủ tục, điều kiện, ưu đãi&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zU"><mxGeometry x="16" y="26" width="357" height="54" as="geometry"/></mxCell><mxCell id="u2" value="&lt;b style=&quot;font-size