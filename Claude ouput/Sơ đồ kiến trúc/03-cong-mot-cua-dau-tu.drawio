t-size:10px;color:#475569;&quot;&gt;tỉnh · KCN · KKT&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#EFF6FF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="200" height="60" as="geometry"/></mxCell><mxCell id="ud" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Ưu đãi đầu tư&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;thuế · đất · thủ tục&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#EFF6FF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="420" y="690" width="200" height="60" as="geometry"/></mxCell><mxCell id="e1_tt_hs" value="YÊU_CẦU" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tt" target="hs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2_hs_bm" value="THEO_MẪU" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hs" target="bm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3_tt_cq" value="THẨM_QUYỀN" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tt" target="cq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4_tt_th" value="THỜI_HẠN" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tt" target="th"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5_tt_dk" value="CĂN_CỨ" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tt" target="dk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6_dk_vb" value="THUỘC" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dk" target="vb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7_nn_tt" value="ÁP_DỤNG" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nn" target="tt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8_nn_dkdt" value="PHẢI_ĐÁP_ỨNG" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nn" target="dkdt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9_nn_dm" value="THUỘC" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nn" target="dm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10_da_tt" value="THỰC_HIỆN" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="da" target="tt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11_da_db" value="ĐẶT_TẠI" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="da" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12_db_ud" value="HƯỞNG" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="db" target="ud"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13_da_nn" value="HOẠT_ĐỘNG" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="da" target="nn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14_dkdt_dk" value="CĂN_CỨ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dkdt" target="dk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ex" value="&lt;b&gt;Ví dụ truy vấn nhiều bước&lt;/b&gt;&lt;br&gt;&quot;Nhà đầu tư Hàn Quốc muốn lập nhà máy linh kiện điện tử ở KCN tại Bắc Ninh: cần thủ tục gì, nộp ở đâu, được ưu đãi gì?&quot;&lt;br&gt;&lt;br&gt;1. Map ngành nghề → điều kiện với NĐT nước ngoài&lt;br&gt;2. Dự án → địa bàn KCN → ưu đãi đang hiệu lực&lt;br&gt;3. Thủ tục cấp IRC → thành phần hồ sơ → cơ quan (BQL KCN) → thời hạn&lt;br&gt;4. Mỗi ý kèm điều/khoản và ngày hiệu lực; thiếu dữ kiện thì hỏi lại quy mô vốn, tỷ lệ sở hữu" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#CA8A04;fillColor=#FEFCE8;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="900" y="640" width="660" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>