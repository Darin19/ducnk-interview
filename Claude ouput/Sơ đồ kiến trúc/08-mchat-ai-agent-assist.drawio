Geometry x="40" y="50" width="1520" height="22" as="geometry"/></mxCell><mxCell id="pe" value="&lt;b style=&quot;font-size:12px;&quot;&gt;PENDING&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;idempotency key = convId-msgId-type&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#EFF6FF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="200" height="62" as="geometry"/></mxCell><mxCell id="pr" value="&lt;b style=&quot;font-size:12px;&quot;&gt;PROCESSING&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;1 job active / hội thoại&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#F5F3FF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="200" height="62" as="geometry"/></mxCell><mxCell id="co" value="&lt;b style=&quot;font-size:12px;&quot;&gt;COMPLETED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;đẩy SSE lên Agent UI&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#ECFDF5;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="580" y="130" width="200" height="62" as="geometry"/></mxCell><mxCell id="st" value="&lt;b style=&quot;font-size:12px;&quot;&gt;STALE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;có tin mới sau from/to message&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#F9FAFB;strokeColor=#6B7280;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="200" height="62" as="geometry"/></mxCell><mxCell id="ca" value="&lt;b style=&quot;font-size:12px;&quot;&gt;CANCELLED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;Manual thay thế Idle cùng target&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#F9FAFB;strokeColor=#6B7280;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="200" height="62" as="geometry"/></mxCell><mxCell id="fa" value="&lt;b style=&quot;font-size:12px;&quot;&gt;FAILED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;timeout · JSON sai schema&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#FEF2F2;strokeColor=#DC2626;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="320" y="300" width="200" height="62" as="geometry"/></mxCell><mxCell id="re" value="&lt;b style=&quot;font-size:12px;&quot;&gt;RETRYING&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;backoff · tối đa N lần&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#FFF7ED;strokeColor=#EA580C;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="580" y="300" width="200" height="62" as="geometry"/></mxCell><mxCell id="dl" value="&lt;b style=&quot;font-size:12px;&quot;&gt;DEAD_LETTER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;không chặn chat · cảnh báo vận hành&lt;/span&gt;" style="rounded=1;arcSize=40;fillColor=#FEF2F2;strokeColor=#DC2626;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="200" height="62" as="geometry"/></mxCell><mxCell id="e1_pe_pr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pe" target="pr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2_pr_co" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pr" target="co"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3_co_st" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="co" target="st"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4_fa_re" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fa" target="re"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5_re_dl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="re" target="dl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6_pe_ca" value="bị thay thế" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pe" target="ca"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7_pr_fa" value="lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pr" target="fa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8_re_pr" value="thử lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="re" target="pr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9_st_pe" value="phân tích lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st" target="pe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tr" value="&lt;b&gt;Trigger &amp; ưu tiên&lt;/b&gt;&lt;br&gt;P1 MANUAL (nút &quot;AI gợi ý&quot;)&lt;br&gt;P2 SPEAKER_CHANGED (khách ↔ agent)&lt;br&gt;P3 CUSTOMER_IDLE (5 phút từ tin cuối)&lt;br&gt;+ agent nhận / chuyển nhóm (handover summary) · tạm dừng · đóng (final analysis)&lt;br&gt;&lt;br&gt;&lt;b&gt;Chống trigger thừa&lt;/b&gt;&lt;br&gt;debounce 5–10s · gom tin thành turn · cooldown 30s · bỏ &quot;ok/vâng/sticker&quot;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#7C3AED;fillColor=#F5F3FF;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="460" height="250" as="geometry"/></mxCell><mxCell id="tl" value="&lt;b&gt;Dòng thời gian ví dụ&lt;/b&gt; · T+0,2s lưu DB · T+0,5s routing · T+1s agent thấy hội thoại · T+5–10s gom tin · T+12s insight hiện trên panel" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#F8FAFC;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="1500" height="44" as="geometry"/></mxCell><mxCell id="ac" value="&lt;b&gt;AC mẫu&lt;/b&gt; · Given khách đổi từ &quot;mua&quot; sang &quot;hủy&quot; khi job đang chạy, When job cũ hoàn tất, Then job cũ chuyển STALE, insight hiện hành vẫn theo phiên bản hội thoại mới; kết quả cũ chỉ lưu cho audit." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#059669;fillColor=#ECFDF5;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="1500" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>