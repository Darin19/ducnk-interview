rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12_r5_o0" value="enqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r5" target="o0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13_o1_n1" value="dưới ngưỡng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14_n1_o3" value="người duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15_o1_f1" value="lỗi kỹ thuật" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ac" value="&lt;b&gt;Tiêu chí nghiệm thu ingestion (trích)&lt;/b&gt;&lt;br&gt;• 100% file có document_id; file gốc không bị ghi đè&lt;br&gt;• Retry không tạo job/chứng từ trùng (idempotency key)&lt;br&gt;• Phụ lục, bản sửa lưu version mới (parent_document_id)&lt;br&gt;• Chặn trình phê duyệt khi còn trường Critical chưa review&lt;br&gt;• Mọi chuyển trạng thái có audit log" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#059669;fillColor=#ECFDF5;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="836" y="520" width="760" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>