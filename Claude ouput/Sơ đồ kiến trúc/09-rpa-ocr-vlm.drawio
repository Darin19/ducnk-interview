/></mxCell><mxCell id="v1" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Business validation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;trước thuế + VAT = tổng · tổng % mốc TT = 100%&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zV"><mxGeometry x="16" y="31" width="282" height="64" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Cross-document match&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;HĐ ↔ Invoice ↔ PL ↔ tờ khai nháp&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zV"><mxGeometry x="318" y="31" width="282" height="64" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Confidence gate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;≥0,95 tự nhập · 0,80–0,95 review · &amp;lt;0,80 VLM/tay · MST ≥0,99&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zV"><mxGeometry x="619" y="31" width="282" height="64" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Human review UI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;ảnh trái · form phải · highlight bbox · phím tắt&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zV"><mxGeometry x="921" y="31" width="282" height="64" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Correction log&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;giá trị AI + giá trị sửa → revie