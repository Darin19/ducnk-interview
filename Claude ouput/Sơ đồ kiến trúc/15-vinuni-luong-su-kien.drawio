<mxfile host="Electron" agent="Claude" version="24.0.0"><diagram id="p1" name="1. Camera báo → robot xác minh"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1720" pageHeight="1200" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="15 · Luồng chính: Camera AI báo sự kiện → robot xác minh → bảo vệ xử lý" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1640" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Mission (robot đi quan sát) và Incident (sự cố an ninh) là hai vòng đời riêng; mission xong không tự đóng incident." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1640" height="22" as="geometry"/></mxCell><mxCell id="l1" value="Camera AI / VMS" style="swimlane;horizontal=0;startSize=140;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#475569;fontStyle=1;fontSize=13;fontColor=#475569;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1640" height="110" as="geometry"/></mxCell><mxCell id="l2" value="Event &amp;amp; Incident" style="swimlane;horizontal=0;startSize=140;html=1;whiteSpace=wrap;fillColor=#FFF1F2;strokeColor=#E11D48;fontStyle=1;fontSize=13;fontColor=#E11D48;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1640" height="110" as="geometry"/></mxCell><mxCell id="l3" value="Mission &amp;amp; Fleet" style="swimlane;horizontal=0;startSize=140;html=1;whiteSpace=wrap;fillColor=#F5F3FF;strokeColor=#7C3AED;fontStyle=1;fontSize=13;fontColor=#7C3AED;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="1640" height="110" as="geometry"/></mxCell><mxCell id="l4" value="Robot" style="swimlane;horizontal=0;startSize=140;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;fontSize=13;fontColor=#2563EB;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1640" height="110" as="geometry"/></mxCell><mxCell id="l5" value="SOC / Bảo vệ" style="swimlane;horizontal=0;startSize=140;html=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;fontStyle=1;fontSize=13;fontColor=#059669;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1640" height="110" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1 · Phát hiện&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;người ở khu hạn chế 23:15 · 96%&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#475569;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="l1"><mxGeometry x="156" y="20" width="136" height="72" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2 · Đánh giá bối cảnh&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;dedup · access control · lịch&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E11D48;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="l2"><mxGeometry x="304" y="20" width="136" height="72" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3 · Incident OPEN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;UNVERIFIED_PRESENCE&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E11D48;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="l2"><mxGeometry x="452" y="20" width="136" height="72" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4 · Mission&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;VERIFY_SECURITY_EVENT&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="l3"><mxGeometry x="600" y="20" width="136" height="72" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5 · Chọn robot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;lọc capability · pin · map · ODD → điểm&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="l3"><mxGeometry x="748" y="20" width="136" height="72" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6 · ACK &amp;amp; di chuyển&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;tới điểm quan sát an toàn&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="l4"><mxGeometry x="896" y="20" width="136" height="72" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7 · Quan sát&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;ảnh/clip · VLM mô tả · loa nếu được phép&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="l4"><mxGeometry x="1044" y="20" width="136" height="72" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8 · Bảo vệ xác minh&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;xem bằng chứng · phân loại&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="l5"><mxGeometry x="1192" y="20" width="136" height="72" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9 · Ghi kết quả&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;đóng · false alarm · escalate&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E11D48;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="l2"><mxGeometry x="1340" y="20" width="136" height="72" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10 · Mission xong&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;robot về tuyến tuần tra&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="l3"><mxGeometry x="1488" y="20" width="136" height="72" as="geometry"/></mxCell><mxCell id="e1_s1_s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2_s2_s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3_s3_s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4_s4_s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5_s5_s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6_s6_s7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7_s7_s8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8_s8_s9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9_s9_s10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ex" value="&lt;b&gt;Luồng ngoại lệ đã đặc tả&lt;/b&gt;&lt;br&gt;E1 · Không có robot đủ điều kiện → chuyển bảo vệ ngay, dashboard nói rõ lý do (không hiện &quot;đang xác minh&quot;)&lt;br&gt;E2 · Không nhận ACK → kiểm tra assignment rồi mới retry; không gửi lệnh trùng cho robot khác&lt;br&gt;E3 · Robot mất mạng sau khi nhận → EXECUTION_UNKNOWN; áp lease/fencing, không tái giao chỉ vì timeout&lt;br&gt;E4 · Hành lang bị khóa / đông người → điểm quan sát thay thế · robot khác · bảo vệ trực tiếp&lt;br&gt;E5 · Người tại chỗ không hợp tác → robot lùi về vị trí an toàn, không truy đuổi, không dùng lực&lt;br&gt;E6 · Camera cùng lúc báo nhiều khung hình / 2 robot cùng thấy → 1 incident, gom quan sát" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="1100" height="170" as="geometry"/></mxCell><mxCell id="kp" value="&lt;b&gt;KPI đo từ trace&lt;/b&gt;&lt;br&gt;• Event → bằng chứng tới bảo vệ: median / p95&lt;br&gt;• Tỷ lệ xác minh đúng · cảnh báo giả / robot-giờ&lt;br&gt;• Mission hoàn thành / mission nhận trong ODD&lt;br&gt;• Số lần con người can thiệp / mission" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;strokeColor=#059669;fillColor=#ECFDF5;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1160" y="655" width="520" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>