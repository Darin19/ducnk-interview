<mxfile host="Electron" agent="Claude" version="24.0.0"><diagram id="p1" name="1. Edge–cloud &amp; AI camera"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="05 · Smart Safe — IoT an ninh, cháy nổ + AI Camera xác minh cảnh báo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1520" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Khoảng 400 cửa hàng, hơn 5.000 thiết bị. AI camera giảm cảnh báo giả bằng cách xác minh sự kiện cảm biến ngay tại edge." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1520" height="22" as="geometry"/></mxCell><mxCell id="zS" value="Tại cửa hàng (edge)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#2563EB;container=1;collapsible=0;recursiveResize=0;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="560" height="420" as="geometry"/></mxCell><mxCell id="se" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Cảm biến&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;khói · nhiệt · gas · cửa từ · PIR · vỡ kính&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zS"><mxGeometry x="16" y="34" width="250" height="80" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b style=&quot;font-size:12px;&quot;&gt;IoT Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;Zigbee/RF → 4G/Ethernet · heartbeat · nhận lệnh&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zS"><mxGeometry x="16" y="140" width="250" height="72" as="geometry"/></mxCell><mxCell id="si" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Còi / đèn tại chỗ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;điều khiển từ xa · ACK&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zS"><mxGeometry x="16" y="240" width="250" height="60" as="geometry"/></mxCell><mxCell id="ca" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Camera IP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;RTSP / ONVIF · H.265&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zS"><mxGeometry x="290" y="34" width="254" height="80" as="geometry"/></mxCell><mxCell id="ed" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Edge AI box&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E2E8F0;&quot;&gt;NVIDIA Jetson Orin NX · DeepStream&lt;br&gt;YOLOv8 + ByteTrack (TensorRT INT8)&lt;br&gt;rule vùng &amp;amp; lịch giám sát&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#2563EB;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;fontColor=#FFFFFF;" vertex="1" parent="zS"><mxGeometry x="290" y="140" width="254" height="100" as="geometry"/></mxCell><mxCell id="bu" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Bộ đệm offline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;SQLite · gửi lại khi có mạng&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#FFFFFF;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zS"><mxGeometry x="290" y="260" width="254" height="60" as="geometry"/></mxCell><mxCell id="nt" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Lưu ý thiết kế&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;Edge gửi metadata + snapshot; clip kéo khi cần xác minh. Camera mất kết nối ≠ &quot;không có xâm nhập&quot;.&lt;/span&gt;" style="shape=note;size=12;fillColor=#FEFCE8;strokeColor=#CA8A04;align=left;spacingLeft=6;verticalAlign=top;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="56" y="424" width="528" height="70" as="geometry"/></mxCell><mxCell id="zC" value="Smart Safe Cloud (SaaS)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#7C3AED;container=1;collapsible=0;recursiveResize=0;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="940" height="420" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b style=&quot;font-size:12px;&quot;&gt;MQTT broker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;EMQX · TLS · ACL theo thiết bị&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zC"><mxGeometry x="16" y="34" width="212" height="66" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Ingestion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;validate · dedup event_id · sequence_no&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#7C3AED;whiteSpace=wrap;html=1;fontColor=#0F172A;strokeWidth=1.4;" vertex="1" parent="zC"><mxGeometry x="248" y="34" width="212" height="66" as="geometry"/></mxCell><mxCell id="c3" va